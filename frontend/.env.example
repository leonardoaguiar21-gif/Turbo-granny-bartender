# Frontend-safe public backend URL.
# Used in frontend/src/composables/useCocktailRecommendations.ts.
# Local development can omit this because Vite proxies /api to the local backend.
# Production should use the Railway backend URL, for example:
# VITE_API_URL=https://turbo-granny-bartender-api.up.railway.app
VITE_API_URL=
